<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RezDevOps.FecCheck.Core</RootNamespace>
    <AssemblyName>RezDevOps.FecCheck.Core</AssemblyName>
    <Description>Bibliothèque de validation FEC (Fichier des Écritures Comptables). Sans I/O, testable à 100 %.</Description>

    <!--
      Marque l'assembly comme trim-safe : il n'utilise pas de réflexion ni
      d'API non-AOT-friendly. Indispensable pour que le CLI puisse publier en
      Native AOT (J5) sans warning IL2104 ni élagage trop agressif. Si une
      future règle introduit une API non-trimmable, le build CLI échouera et
      forcera la décision (ajouter une DynamicDependency, ou désactiver le
      trimming sur cette zone précise) plutôt que de laisser passer une
      régression silencieuse.
    -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Aucune PackageReference. Depuis .NET 10, le type CodePagesEncodingProvider
    (utilisé pour décoder ISO-8859-15 hors Windows, requis par l'A. 47 A-1 LPF
    pour les FEC) est fourni nativement par la BCL. Le package OOB historique
    System.Text.Encoding.CodePages 8.0.0 a donc été retiré à la migration v1.1.0
    (warning NU1510 du SDK .NET 10 sur les références pruned).

    L'enregistrement explicite via Encoding.RegisterProvider(CodePagesEncodingProvider.Instance)
    reste nécessaire au runtime sur Linux/macOS (cf. EncodingDetector.EnsureCodePagesRegistered).
    Seul le package NuGet est devenu superflu.
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="RezDevOps.FecCheck.Core.Tests" />
  </ItemGroup>

</Project>
