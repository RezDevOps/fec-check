<!--
  Propriétés communes à tous les projets de la solution fec-check.
  Une seule source de vérité pour la cible .NET, le niveau de langue,
  et les métadonnées d'assemblage.
-->
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>fr-FR</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="Métadonnées d'assemblage">
    <Authors>Rudy Rezaire</Authors>
    <Company>RezDevOps</Company>
    <Product>fec-check</Product>
    <Copyright>Copyright (c) 2026 Rudy Rezaire / RezDevOps</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/RezDevOps/fec-check</RepositoryUrl>
    <!--
      Source de vérité unique pour la version d'assemblage. Doit rester alignée
      sur FecCheckInfo.Version et sur le tag git associé. La CI release surcharge
      au besoin via -p:Version=$tag pour publier des prereleases sans toucher au
      fichier (utile pour les rc/beta).
    -->
    <Version>1.1.0</Version>
  </PropertyGroup>

</Project>
