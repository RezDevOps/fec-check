# EditorConfig — fec-check
# Source : https://editorconfig.org/
# Conventions .NET basées sur les recommandations officielles Microsoft,
# adaptées à la posture RezDevOps (rigueur, cohérence, peu de surprise).

root = true

# --- Tous les fichiers ---
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# --- Markdown : pas de trim pour préserver les retours forcés " " ---
[*.md]
trim_trailing_whitespace = false

# --- Configurations / scripts ---
[*.{yml,yaml,json}]
indent_size = 2

[*.{xml,csproj,props,targets,sln}]
indent_size = 2

# --- Code C# ---
[*.cs]
indent_size = 4

# Règles de style essentielles
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Modificateurs
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_readonly_field = true:warning

# Préférences de langue
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Naming
# Note : l'ordre compte. Les règles plus spécifiques (const, static readonly)
# doivent précéder la règle générique sur les champs privés mutables, sinon
# Roslyn appliquerait le préfixe `_` à des constantes — ce qui est non
# idiomatique en C#.

# Constantes (n'importe quelle accessibilité) → PascalCase, sans préfixe.
dotnet_naming_rule.constants_should_be_pascal_case.severity = warning
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case_no_prefix

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

# Champs static readonly (n'importe quelle accessibilité) → PascalCase, sans préfixe.
dotnet_naming_rule.static_readonly_should_be_pascal_case.severity = warning
dotnet_naming_rule.static_readonly_should_be_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_should_be_pascal_case.style = pascal_case_no_prefix

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static,readonly

# Champs privés mutables (instance) → _camelCase.
dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private,private_protected

# Styles partagés.
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.pascal_case_no_prefix.capitalization = pascal_case

# --- FEC fixtures : ce sont des données de test, pas du code ---
[tests/fixtures/**]
end_of_line = unset
charset = unset
trim_trailing_whitespace = false
insert_final_newline = false
